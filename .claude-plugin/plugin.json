{
  "name": "memory-bank",
  "version": "0.2.0",
  "description": "Initialize and maintain a structured memory bank of markdown files that preserve project context across sessions.",
  "author": {
    "name": "cjgl23"
  },
  "homepage": "https://github.com/cjgl23/claude-memory-bank-plugin",
  "repository": "https://github.com/cjgl23/claude-memory-bank-plugin",
  "license": "Apache-2.0",
  "keywords": ["memory", "context", "documentation", "project-state"],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/memory-bank-hook.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
